VERSION="4.0.0"

# predictable safe file permissions
umask 022

FILE=""
QUIET=0
RAW=0
NOEXEC=0
CRUSH=0
NOBACKUP=0
DRYRUN=0
INSERT=0
PATCH=0
PATHINFO=0


# ---------- basic output ----------

say()
{
    [ "$QUIET" -eq 0 ] && echo "$*"
}


warn()
{
    echo "[CATHY WARNING] $*"
}


fail_safe()
{
    echo
    echo "[CATHY STOP]"
    echo "$*"
    echo "No changes were made."
    exit 1
}


# ---------- command detection ----------

have()
{
    command -v "$1" >/dev/null 2>&1
}


# ---------- BusyBox support ----------

BB=""

for p in \
/bin/busybox \
/usr/bin/busybox \
/sbin/busybox \
/system/bin/busybox \
/system/xbin/busybox
do
    [ -x "$p" ] && BB="$p" && break
done


ms_cp()
{
    if have cp; then
        cp "$@"
    elif [ -n "$BB" ]; then
        "$BB" cp "$@"
    else
        return 1
    fi
}


ms_mv()
{
    if have mv; then
        mv "$@"
    elif [ -n "$BB" ]; then
        "$BB" mv "$@"
    else
        return 1
    fi
}


ms_chmod()
{
    if have chmod; then
        chmod "$@"
    elif [ -n "$BB" ]; then
        "$BB" chmod "$@"
    else
        return 1
    fi
}


ms_mkdir()
{
    if have mkdir; then
        mkdir "$@"
    elif [ -n "$BB" ]; then
        "$BB" mkdir "$@"
    else
        return 1
    fi
}


# ---------- backup ----------

make_backup()
{
    [ "$NOBACKUP" -eq 1 ] && return 0

    [ -f "$FILE" ] || return 0

    BACKUP="$FILE.bak.$(date +%Y%m%d%H%M%S)"

    say "Backup:"
    say " $BACKUP"

    ms_cp "$FILE" "$BACKUP" ||
        fail_safe "Cannot create backup."
}


# ---------- terminal safety ----------

terminal_safe()
{
    stty sane 2>/dev/null
}


# ---------- CRLF cleaning ----------

clean_crlf()
{
    [ "$CRUSH" -eq 0 ] && return 0

    if have sed; then
        sed -i 's/\r$//' "$FILE" 2>/dev/null && return 0
    fi

    if have tr; then
        TMP="$FILE.cathy-clean"

        tr -d '\r' < "$FILE" > "$TMP" &&
        ms_mv "$TMP" "$FILE" &&
        return 0
    fi

    warn "Cannot remove CRLF. File unchanged."
}


# ---------- permissions ----------

set_permissions()
{
    [ "$NOEXEC" -eq 1 ] && return 0

    ms_chmod 755 "$FILE" ||
        warn "Cannot set executable permission."
}

# ---------- usage ----------

usage()
{
cat <<EOF

