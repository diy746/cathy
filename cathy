echo "Finish with CTRL+D"
echo "----------------"


cat >> "$FILE"


terminal_safe


clean_crlf


set_permissions


echo
echo "[✓] Cathy finished:"
echo "$FILE"
# ---------- insert mode ----------

insert_mode()
{
    echo
    echo "[CATHY INSERT]"

    printf "Insert after line: "
    read LINE

    case "$LINE" in
        ''|*[!0-9]*)
            fail_safe "Invalid line number."
            ;;
    esac

    TMP="$FILE.cathy-insert"

    [ -f "$FILE" ] ||
        fail_safe "File does not exist."

    echo
    echo "Paste new block."
    echo "Finish with CTRL+D"
    echo "----------------"

    terminal_safe

    if have head && have tail; then

        head -n "$LINE" "$FILE" > "$TMP"

        cat >> "$TMP"

        tail -n +"$((LINE+1))" "$FILE" >> "$TMP"

    else

        fail_safe "head/tail unavailable."

    fi

    terminal_safe

    echo
    echo "Preview:"
    echo

    if have diff; then
        diff -u "$FILE" "$TMP"
    fi

    printf "Replace original? [y/N] "
    read ANSWER

    case "$ANSWER" in
    y|Y)
        make_backup
        ms_mv "$TMP" "$FILE" ||
            fail_safe "Replacement failed."

        set_permissions

        echo "[✓] Insert completed."
        ;;

    *)
        rm -f "$TMP"
        echo "Cancelled. Original unchanged."
        ;;
    esac
}


# ---------- patch mode ----------

patch_mode()
{
    NEW="$FILE.cathy-new"

    [ -f "$FILE" ] ||
        fail_safe "File does not exist."

    make_backup

    ms_cp "$FILE" "$NEW" ||
        fail_safe "Cannot create working copy."

    echo
    echo "Edit this file:"
    echo "$NEW"
    echo

    echo "When finished run:"
    echo " cathy --apply $FILE"
}


# ---------- apply patch ----------

apply_patch()
{
    NEW="$FILE.cathy-new"

    [ -f "$NEW" ] ||
        fail_safe "No Cathy patch file found."

    echo
    echo "[CATHY APPLY]"

    if have diff; then
        diff -u "$FILE" "$NEW"
    fi

    printf "Replace original? [y/N] "
    read ANSWER

    case "$ANSWER" in

    y|Y)

        make_backup

        ms_mv "$NEW" "$FILE" ||
            fail_safe "Cannot replace file."

        set_permissions

        echo "[✓] Patch applied."

        ;;

    *)

        echo "Cancelled."
        ;;

    esac
}


# ---------- final mode selection ----------

if [ "$INSERT" -eq 1 ]; then
    insert_mode
    exit 0
fi
# ---------- Cathy safety additions ----------

check_file()
{
    TARGET="$1"

    [ -f "$TARGET" ] ||
    fail_safe "File does not exist."

    if sh -n "$TARGET" 2>/dev/null; then
        echo "[✓] Syntax OK"
    else
        echo "[CATHY ERROR]"
        echo "Shell syntax problem detected."
        exit 1
    fi
}

